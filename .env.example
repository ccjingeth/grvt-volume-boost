# GRVT Trading Tool Configuration
# Copy this file to .env and fill in your values

# Chain configuration
# Environment: prod | testnet
GRVT_ENV=prod
# Language: en | zh
GRVT_LANG=en
# Chain ID used in EIP-712 domain (defaults: 325 for prod, 326 for testnet).
# Leave blank unless you know you need to override it.
# GRVT_CHAIN_ID=

# URLs (optional)
# Leave these unset to let `GRVT_ENV` (prod/testnet) pick the correct defaults automatically.
# GRVT_TRADES_BASE_URL=
# GRVT_MARKET_DATA_BASE_URL=
# GRVT_ORIGIN=
# GRVT_WS_URL=
# GRVT_EDGE_URL=

# Debug / signing
# Optional: enable extra stderr logging
# GRVT_DEBUG=1
# Optional: signature expiration (seconds). Docs cap this at 30 days.
# If you see "exceeded max signature expiration", first verify your system clock is correct,
# then optionally lower this value (default: 6h).
# GRVT_SIGNATURE_EXPIRATION_SEC=21600

# Accounts
# No account IDs/keys are required in .env.
# Account 1 and 2 sessions are created via QR login and stored under `session/grvt_browser_state_1.json`
# and `session/grvt_browser_state_2.json`.

# API-key mode (optional, no QR login)
# Provide API key + secret + private key to seed a session file.
# Optional: you can also set GRVT_GRAVITY_* to skip API login.
#
# Account 1
# GRVT_API_KEY_1=
# GRVT_API_SECRET_1=
# GRVT_API_PASSPHRASE_1=
# GRVT_PRIVATE_KEY_1=
# GRVT_GRAVITY_1=
# GRVT_ACCOUNT_ID_1=
# GRVT_CHAIN_SUB_ACCOUNT_ID_1=
# GRVT_SUB_ACCOUNT_ID_1=
#
# Account 2
# GRVT_API_KEY_2=
# GRVT_API_SECRET_2=
# GRVT_API_PASSPHRASE_2=
# GRVT_PRIVATE_KEY_2=
# GRVT_GRAVITY_2=
# GRVT_ACCOUNT_ID_2=
# GRVT_CHAIN_SUB_ACCOUNT_ID_2=
# GRVT_SUB_ACCOUNT_ID_2=
#
# Optional: override API login endpoint
# GRVT_API_LOGIN_URL=

# Telegram notifications were removed.
